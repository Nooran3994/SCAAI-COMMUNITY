# ── SCAAI-COMMUNITY .gitignore ───────────────────────────────
# Purpose: keep this repo 100% free of source code, secrets, and
# build artifacts. Only docs and release metadata live here.
# The guard at scripts/guard.sh enforces this on every push.

# ── Source code — NEVER track these ──────────────────────────
src/
**/src/
main.js
app.js
index.js
preload.js
*.tsx
*.jsx

# ── Secrets & config — NEVER track ───────────────────────────
*.env
*.env.*
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.der
config.json
supabase.js
supabase-client.js
service-account*.json
credentials*.json
secrets*.json
config.local.*
settings.local.json

# ── Dependencies & build output ──────────────────────────────
node_modules/
dist/
build/
out/
release/*.exe
release/*.blockmap
release/*.zip
release/win-unpacked/
*.app
*.dmg
builder-debug.yml
builder-effective-config.yaml
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.iml

# ── Local scaai runtime bits (paths leaked before — block again) ──
.scaai/
*.user.js